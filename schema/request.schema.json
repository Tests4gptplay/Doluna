{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Short Task Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "task_id", "kind", "shell", "command"],
  "properties": {
    "v": { "const": 1 },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "kind": { "const": "command" },
    "shell": { "enum": ["pwsh", "cmd"] },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600,
      "default": 300
    },
    "working_directory": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
